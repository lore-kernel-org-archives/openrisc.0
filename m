-
-	for_each_cpu(cpu, &callmap) {
-		BUG_ON(cpu >=3D 2);
-		SSYNC();
-		bfin_write_SICB_SYSCR(bfin_read_SICB_SYSCR() | (1 << (offset + cpu)));
-		SSYNC();
-	}
-}
-
-void platform_send_ipi_cpu(unsigned int cpu, int irq)
-{
-	int offset =3D (irq =3D=3D IRQ_SUPPLE_0) ? 6 : 8;
