-  IF CC JUMP .Lident_return;
-
-  CC =3D R1 =3D=3D 1;                   /* check for divide by 1 */
-  IF CC JUMP .Lident_return;
-
-  R2.L =3D ONES R1;
-  R2 =3D R2.L (Z);
-  CC =3D R2 =3D=3D 1;
-  IF CC JUMP .Lpower_of_two;
-
-  /* Identities haven't helped either.
-  ** Perform the full division process.
-  */
-
-  P1 =3D 31;                        /* Set loop counter   */
-
-  [--SP] =3D (R7:5);                /* Push registers R5-R7 */
-  R2 =3D -R1;
-  [--SP] =3D R2;
-  R2 =3D R0 << 1;                   /* R2 lsw of dividend  */
-  R6 =3D R0 ^ R1;                   /* Get sign */
-  R5 =3D R6 >> 31;                  /* Shift sign to LSB */
-
-  R0 =3D 0 ;                        /* Clear msw partial remainder */
-  R2 =3D R2 | R5;                   /* Shift quotient bit */
-  R6 =3D R0 ^ R1;                   /* Get new quotient bit */
-
-  LSETUP(.Llst,.Llend)  LC0 =3D P1;   /* Setup loop */
-.Llst:   R7 =3D R2 >> 31;            /* record copy of carry from R2 */
-        R2 =3D R2 << 1;             /* Shift 64 bit dividend up by 1 bit */
-        R0 =3D R0 << 1 || R5 =3D [SP];
-        R0 =3D R0 | R7;             /* and add carry */
-        CC =3D R6 < 0;              /* Check quotient(AQ) */
-                                  /* we might be subtracting divisor (AQ=
=3D=3D0) */
-        IF CC R5 =3D R1;            /* or we might be adding divisor  (AQ=
=3D=3D1)*/
-        R0 =3D R0 + R5;             /* do add or subtract, as indicated by=
 AQ */
-        R6 =3D R0 ^ R1;             /* Generate next quotient bit */
-        R5 =3D R6 >> 31;
-                                  /* Assume AQ=3D=3D1, shift in zero */
-        BITTGL(R5,0);             /* tweak AQ to be what we want to shift =
in */
-.Llend:  R2 =3D R2 + R5;             /* and then set shifted-in value to
-                                  ** tweaked AQ.
-                                  */
-  r1 =3D r3 >> 31;
-  r2 =3D r2 + r1;
-  cc =3D bittst(r3,30);
-  r0 =3D -r2;
-  if !cc r0 =3D r2;
-  SP +=3D 4;
-  (R7:5)=3D [SP++];                 /* Pop registers R6-R7 */
-  RTS;
-
-.Lident_return:
-  CC =3D R1 =3D=3D 0;                   /* check for divide by zero  =3D> =
0x7fffffff */
-  R2 =3D -1 (X);
-  R2 >>=3D 1;
-  IF CC JUMP .Ltrue_ident_return;
-
-  CC =3D R0 =3D=3D R1;                  /* check for identical operands =
=3D> 1 */
-  R2 =3D 1 (Z);
-  IF CC JUMP .Ltrue_ident_return;
-
-  R2 =3D R0;                        /* assume divide by 1 =3D> numerator */
-  /*FALLTHRU*/
-
-.Ltrue_ident_return:
-  R0 =3D R2;                        /* Return an identity value */
-  R2 =3D -R2;
-  CC =3D bittst(R3,30);
-  IF CC R0 =3D R2;
-.Lzero_return:
-  RTS;                            /* ...including zero */
-
-.Lpower_of_two:
-  /* Y has a single bit set, which means it's a power of two.
-  ** That means we can perform the division just by shifting
-  ** X to the right the appropriate number of bits
-  */
-
-  /* signbits returns the number of sign bits, minus one.
-  ** 1=3D>30, 2=3D>29, ..., 0x40000000=3D>0. Which means we need
-  ** to shift right n-signbits spaces. It also means 0x80000000
-  ** is a special case, because that *also* gives a signbits of 0
-  */
-
-  R2 =3D R0 >> 31;
-  CC =3D R1 < 0;
-  IF CC JUMP .Ltrue_ident_return;
-
-  R1.l =3D SIGNBITS R1;
-  R1 =3D R1.L (Z);
-  R1 +=3D -30;
-  R0 =3D LSHIFT R0 by R1.L;
-  r1 =3D r3 >> 31;
-  r0 =3D r0 + r1;
-  R2 =3D -R0;                       // negate result if necessary
-  CC =3D bittst(R3,30);
-  IF CC R0 =3D R2;
-  RTS;
-
-.Lret_zero:
-  R0 =3D 0;
-  RTS;
-
-.size ___divsi3, .-___divsi3
