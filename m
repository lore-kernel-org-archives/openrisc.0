+    sim_io_eprintf(sd, "WARNING: l.mtspr in user mode (SR 0x%x)\n", GET_H_SYS_SR());
+    return;
+  }
+  
+  if (addr >= NUM_SPR)
+    return;
+  
+  switch (addr) {
