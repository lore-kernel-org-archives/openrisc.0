- *
- * 16 / 32 bit signed division.
- *                 Special cases :
- *                      1)  If(numerator =3D=3D 0)
- *                             return 0
- *                      2)  If(denominator =3D=3D0)
- *                             return positive max =3D 0x7fffffff
- *                      3)  If(numerator =3D=3D denominator)
- *                             return 1
- *                      4)  If(denominator =3D=3D1)
- *                             return numerator
- *                      5)  If(denominator =3D=3D -1)
- *                             return -numerator
- *
- *                 Operand         : R0 - Numerator   (i)
- *                                   R1 - Denominator (i)
- *                                   R0 - Quotient    (o)
- *                 Registers Used : R2-R7,P0-P2
- *
- */
-
-.global   ___divsi3;
-.type ___divsi3, STT_FUNC;
-
-#ifdef CONFIG_ARITHMETIC_OPS_L1
-.section .l1.text
-#else
-.text
-#endif
-
-.align 2;
-___divsi3 :
-
-
-  R3 =3D R0 ^ R1;
-  R0 =3D ABS R0;
-
-  CC =3D V;
-
-  r3 =3D rot r3 by -1;
-  r1 =3D abs r1;      /* now both positive, r3.30 means "negate result",
-                    ** r3.31 means overflow, add one to result
-                    */
-  cc =3D r0 < r1;
-  if cc jump .Lret_zero;
-  r2 =3D r1 >> 15;
-  cc =3D r2;
-  if cc jump .Lidents;
-  r2 =3D r1 << 16;
-  cc =3D r2 <=3D r0;
-  if cc jump .Lidents;
-
-  DIVS(R0, R1);
-  DIVQ(R0, R1);
-  DIVQ(R0, R1);
-  DIVQ(R0, R1);
-  DIVQ(R0, R1);
-  DIVQ(R0, R1);
-  DIVQ(R0, R1);
-  DIVQ(R0, R1);
-  DIVQ(R0, R1);
-  DIVQ(R0, R1);
-  DIVQ(R0, R1);
-  DIVQ(R0, R1);
-  DIVQ(R0, R1);
-  DIVQ(R0, R1);
-  DIVQ(R0, R1);
-  DIVQ(R0, R1);
-  DIVQ(R0, R1);
-
-  R0 =3D R0.L (Z);
-  r1 =3D r3 >> 31;    /* add overflow issue back in */
-  r0 =3D r0 + r1;
-  r1 =3D -r0;
-  cc =3D bittst(r3, 30);
-  if cc r0 =3D r1;
-  RTS;
-
-/* Can't use the primitives. Test common identities.
-** If the identity is true, return the value in R2.
-*/
-
-.Lidents:
-  CC =3D R1 =3D=3D 0;                   /* check for divide by zero */
-  IF CC JUMP .Lident_return;
-
-  CC =3D R0 =3D=3D 0;                   /* check for division of zero */
-  IF CC JUMP .Lzero_return;
-
