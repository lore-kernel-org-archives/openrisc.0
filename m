-/* SPDX-License-Identifier: GPL-2.0 */
-#include <linux/linkage.h>
-#include <asm/blackfin.h>
-#include <asm/dpmc.h>
-
-#include <asm/context.S>
-
-#define PM_STACK   (COREA_L1_SCRATCH_START + L1_SCRATCH_LENGTH - 12)
-
-.section .l1.text
-ENTRY(_enter_hibernate)
-	/* switch stack to L1 scratch, prepare for ddr srfr */
-	P0.H =3D HI(PM_STACK);
-	P0.L =3D LO(PM_STACK);
-	SP =3D P0;
-
-	call _bf609_ddr_sr;
-	call _bfin_hibernate_syscontrol;
-
-	P0.H =3D HI(DPM0_RESTORE4);
-	P0.L =3D LO(DPM0_RESTORE4);
-	P1.H =3D _bf609_pm_data;
-	P1.L =3D _bf609_pm_data;
-	[P0] =3D P1;
-
-	P0.H =3D HI(DPM0_CTL);
-	P0.L =3D LO(DPM0_CTL);
-	R3.H =3D HI(0x00000010);
-	R3.L =3D LO(0x00000010);
-
-	bfin_init_pm_bench_cycles;
-
-	[P0] =3D R3;
-
-	SSYNC;
-ENDPROC(_enter_hibernate)
-
-/* DPM wake up interrupt won't wake up core on bf60x if its core IMASK
- * is disabled. This behavior differ from bf5xx serial processor.
- */
-ENTRY(_dummy_deepsleep)
-	[--sp] =3D SYSCFG;
-	[--sp] =3D (R7:0,P5:0);
-	cli r0;
-
-	/* get wake up interrupt ID */
-	P0.l =3D LO(SEC_SCI_BASE + SEC_CSID);
-	P0.h =3D HI(SEC_SCI_BASE + SEC_CSID);
-	R0 =3D [P0];
-
-	/* ACK wake up interrupt in SEC */
-	P1.l =3D LO(SEC_END);
-	P1.h =3D HI(SEC_END);
-
-	[P1] =3D R0;
-	SSYNC;
-
-	/* restore EVT 11 entry */
-	p0.h =3D hi(EVT11);
-	p0.l =3D lo(EVT11);
-	p1.h =3D _evt_evt11;
-	p1.l =3D _evt_evt11;
-
-	[p0] =3D p1;
-	SSYNC;
-
-	(R7:0,P5:0) =3D [sp++];
-	SYSCFG =3D [sp++];
-	RTI;
-ENDPROC(_dummy_deepsleep)
-
-ENTRY(_enter_deepsleep)
-	LINK 0xC;
-	[--sp] =3D (R7:0,P5:0);
-
-	/* Change EVT 11 entry to dummy handler for wake up event */
-	p0.h =3D hi(EVT11);
-	p0.l =3D lo(EVT11);
-	p1.h =3D _dummy_deepsleep;
-	p1.l =3D _dummy_deepsleep;
-
-	[p0] =3D p1;
-
-	P0.H =3D HI(PM_STACK);
-	P0.L =3D LO(PM_STACK);
-
-	EX_SCRATCH_REG =3D SP;
-	SP =3D P0;
-
-	SSYNC;
-
-	/* should put ddr to self refresh mode before sleep */
-	call _bf609_ddr_sr;
-
-	/* Set DPM controller to deep sleep mode */
-	P0.H =3D HI(DPM0_CTL);
-	P0.L =3D LO(DPM0_CTL);
-	R3.H =3D HI(0x00000008);
-	R3.L =3D LO(0x00000008);
-	[P0] =3D R3;
-	CSYNC;
-
-	/* Enable evt 11 in IMASK before idle, otherwise core doesn't wake up. */
-	r0.l =3D 0x800;
-	r0.h =3D 0;
-	sti r0;
-	SSYNC;
-
-	bfin_init_pm_bench_cycles;
-
-	/* Fall into deep sleep in idle*/
-	idle;
-	SSYNC;
-
-	/* Restore PLL after wake up from deep sleep */
-	call _bf609_resume_ccbuf;
-
-	/* turn ddr out of self refresh mode */
-	call _bf609_ddr_sr_exit;
-
-	SP =3D EX_SCRATCH_REG;
-
-	(R7:0,P5:0) =3D [SP++];
-	UNLINK;
-	RTS;
-ENDPROC(_enter_deepsleep)
-
-.section .text
-ENTRY(_bf609_hibernate)
-	bfin_cpu_reg_save;
-	bfin_core_mmr_save;
-
-	P0.H =3D _bf609_pm_data;
-	P0.L =3D _bf609_pm_data;
-	R1.H =3D 0xDEAD;
-	R1.L =3D 0xBEEF;
-	R2.H =3D .Lpm_resume_here;
-	R2.L =3D .Lpm_resume_here;
-	[P0++] =3D R1;
-	[P0++] =3D R2;
-	[P0++] =3D SP;
-
-	P1.H =3D _enter_hibernate;
-	P1.L =3D _enter_hibernate;
-
-	call (P1);
-.Lpm_resume_here:
-
-	bfin_core_mmr_restore;
-	bfin_cpu_reg_restore;
-
-	[--sp] =3D RETI;  /* Clear Global Interrupt Disable */
-	SP +=3D 4;
-
-	RTS;
-
-ENDPROC(_bf609_hibernate)
