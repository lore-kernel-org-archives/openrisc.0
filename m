-static int hw_perf_cache_event(int config, int *evp)
-{
-	unsigned long type, op, result;
-	int ev;
-
-	/* unpack config */
-	type =3D config & 0xff;
-	op =3D (config >> 8) & 0xff;
-	result =3D (config >> 16) & 0xff;
-
-	if (type >=3D PERF_COUNT_HW_CACHE_MAX ||
-	    op >=3D PERF_COUNT_HW_CACHE_OP_MAX ||
-	    result >=3D PERF_COUNT_HW_CACHE_RESULT_MAX)
-		return -EINVAL;
-
-	ev =3D cache_events[type][op][result];
-	if (ev =3D=3D 0)
-		return -EOPNOTSUPP;
-	if (ev =3D=3D -1)
-		return -EINVAL;
-	*evp =3D ev;
-	return 0;
-}
-
-static void bfin_perf_event_update(struct perf_event *event,
-				   struct hw_perf_event *hwc, int idx)
-{
-	u64 prev_raw_count, new_raw_count;
-	s64 delta;
-	int shift =3D 0;
-
-	/*
-	 * Depending on the counter configuration, they may or may not
-	 * be chained, in which case the previous counter value can be
-	 * updated underneath us if the lower-half overflows.
-	 *
-	 * Our tactic to handle this is to first atomically read and
-	 * exchange a new raw count - then add that new-prev delta
-	 * count to the generic counter atomically.
-	 *
-	 * As there is no interrupt associated with the overflow events,
-	 * this is the simplest approach for maintaining consistency.
-	 */
-again:
-	prev_raw_count =3D local64_read(&hwc->prev_count);
-	new_raw_count =3D bfin_pfmon_read(idx);
-
-	if (local64_cmpxchg(&hwc->prev_count, prev_raw_count,
-			     new_raw_count) !=3D prev_raw_count)
-		goto again;
-
-	/*
-	 * Now we have the new raw value and have updated the prev
-	 * timestamp already. We can now calculate the elapsed delta
-	 * (counter-)time and add that to the generic counter.
-	 *
-	 * Careful, not all hw sign-extends above the physical width
-	 * of the count.
-	 */
-	delta =3D (new_raw_count << shift) - (prev_raw_count << shift);
-	delta >>=3D shift;
-
-	local64_add(delta, &event->count);
-}
-
-static void bfin_pmu_stop(struct perf_event *event, int flags)
-{
-	struct cpu_hw_events *cpuc =3D this_cpu_ptr(&cpu_hw_events);
-	struct hw_perf_event *hwc =3D &event->hw;
-	int idx =3D hwc->idx;
-
-	if (!(event->hw.state & PERF_HES_STOPPED)) {
-		bfin_pfmon_disable(hwc, idx);
-		cpuc->events[idx] =3D NULL;
-		event->hw.state |=3D PERF_HES_STOPPED;
-	}
