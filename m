-	/* BF60x support large than 4M CPLB page size */
-#ifdef PAGE_SIZE_16MB
-	cplb_pageflags =3D PAGE_SIZE_16MB;
-	cplb_pagesize =3D SIZE_16M;
-#else
-	cplb_pageflags =3D PAGE_SIZE_4MB;
-	cplb_pagesize =3D SIZE_4M;
-#endif
-
-find_pagesize:
-	addr1 =3D addr & ~(cplb_pagesize - 1);
-	if (addr1 >=3D base && (addr1 + cplb_pagesize) <=3D eaddr) {
-		/*
-		 * This works because
-		 * (PAGE_SIZE_4MB & PAGE_SIZE_1MB) =3D=3D PAGE_SIZE_1MB.
-		 */
-		d_data |=3D cplb_pageflags;
-		addr =3D addr1;
-		goto found_pagesize;
-	} else {
-		if (cplb_pagesize > SIZE_4M) {
-			cplb_pageflags =3D PAGE_SIZE_4MB;
-			cplb_pagesize =3D SIZE_4M;
-			goto find_pagesize;
-		}
-	}
-
-found_pagesize:
-#ifdef CONFIG_BF60x
-	if ((addr >=3D ASYNC_BANK0_BASE)
-		&& (addr < ASYNC_BANK3_BASE + ASYNC_BANK3_SIZE))
-		d_data |=3D PAGE_SIZE_64MB;
-#endif
-
-	/* Pick entry to evict */
-	idx =3D evict_one_dcplb(cpu);
-
-	write_dcplb_data(cpu, idx, d_data, addr);
-
-	return CPLB_RELOADED;
-}
-
-MGR_ATTR int cplb_hdr(int seqstat, struct pt_regs *regs)
-{
-	int cause =3D seqstat & 0x3f;
-	unsigned int cpu =3D raw_smp_processor_id();
-	switch (cause) {
-	case VEC_CPLB_I_M:
-		return icplb_miss(cpu);
-	case VEC_CPLB_M:
-		return dcplb_miss(cpu);
-	default:
-		return CPLB_UNKNOWN_ERR;
-	}
-}
