+  SIM_DESC sd = CPU_STATE(current_cpu);
+
+  if (!GET_H_SYS_SR_SM ()) {
+    sim_io_eprintf(sd, "WARNING: l.mfspr in user mode\n");
+    return;
+  }
+  
+  USI addr = base + offset;
