-
-	nr_dcplb_miss[cpu]++;
-	if (unlikely(status & FAULT_USERSUPV))
-		nr_dcplb_supv_miss[cpu]++;
-
-	base =3D 0;
-	idx =3D 0;
-	do {
-		eaddr =3D dcplb_bounds[idx].eaddr;
-		if (addr < eaddr)
-			break;
-		base =3D eaddr;
-	} while (++idx < dcplb_nr_bounds);
-
-	if (unlikely(idx =3D=3D dcplb_nr_bounds))
-		return CPLB_NO_ADDR_MATCH;
-
-	d_data =3D dcplb_bounds[idx].data;
-	if (unlikely(d_data =3D=3D 0))
-		return CPLB_NO_ADDR_MATCH;
-
-	addr &=3D ~(SIZE_1M - 1);
