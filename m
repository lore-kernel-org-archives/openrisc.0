-	struct hw_perf_event *hwc =3D &event->hw;
-	int idx =3D hwc->idx;
-
-	if (WARN_ON_ONCE(idx =3D=3D -1))
-		return;
-
-	if (flags & PERF_EF_RELOAD)
-		WARN_ON_ONCE(!(event->hw.state & PERF_HES_UPTODATE));
-
-	cpuc->events[idx] =3D event;
-	event->hw.state =3D 0;
-	bfin_pfmon_enable(hwc, idx);
-}
-
-static void bfin_pmu_del(struct perf_event *event, int flags)
-{
-	struct cpu_hw_events *cpuc =3D this_cpu_ptr(&cpu_hw_events);
-
-	bfin_pmu_stop(event, PERF_EF_UPDATE);
-	__clear_bit(event->hw.idx, cpuc->used_mask);
-
-	perf_event_update_userpage(event);
-}
-
-static int bfin_pmu_add(struct perf_event *event, int flags)
-{
-	struct cpu_hw_events *cpuc =3D this_cpu_ptr(&cpu_hw_events);
-	struct hw_perf_event *hwc =3D &event->hw;
-	int idx =3D hwc->idx;
-	int ret =3D -EAGAIN;
-
-	perf_pmu_disable(event->pmu);
-
-	if (__test_and_set_bit(idx, cpuc->used_mask)) {
-		idx =3D find_first_zero_bit(cpuc->used_mask, MAX_HWEVENTS);
-		if (idx =3D=3D MAX_HWEVENTS)
-			goto out;
-
-		__set_bit(idx, cpuc->used_mask);
-		hwc->idx =3D idx;
-	}
-
-	bfin_pfmon_disable(hwc, idx);
-
-	event->hw.state =3D PERF_HES_UPTODATE | PERF_HES_STOPPED;
-	if (flags & PERF_EF_START)
-		bfin_pmu_start(event, PERF_EF_RELOAD);
-
-	perf_event_update_userpage(event);
-	ret =3D 0;
-out:
-	perf_pmu_enable(event->pmu);
-	return ret;
-}
-
-static void bfin_pmu_read(struct perf_event *event)
-{
-	bfin_perf_event_update(event, &event->hw, event->hw.idx);
-}
-
-static int bfin_pmu_event_init(struct perf_event *event)
-{
-	struct perf_event_attr *attr =3D &event->attr;
-	struct hw_perf_event *hwc =3D &event->hw;
-	int config =3D -1;
-	int ret;
-
-	if (attr->exclude_hv || attr->exclude_idle)
-		return -EPERM;
-
-	ret =3D 0;
-	switch (attr->type) {
-	case PERF_TYPE_RAW:
-		config =3D PFMON(0, attr->config & PFMON_MASK) |
-			PFCNT(0, !(attr->config & 0x100));
-		break;
-	case PERF_TYPE_HW_CACHE:
-		ret =3D hw_perf_cache_event(attr->config, &config);
-		break;
-	case PERF_TYPE_HARDWARE:
-		if (attr->config >=3D ARRAY_SIZE(event_map))
-			return -EINVAL;
-
-		config =3D event_map[attr->config];
-		break;
-	}
-
-	if (config =3D=3D -1)
-		return -EINVAL;
-
-	if (!attr->exclude_kernel)
-		config |=3D PFCEN(0, PFCEN_ENABLE_SUPV);
-	if (!attr->exclude_user)
-		config |=3D PFCEN(0, PFCEN_ENABLE_USER);
-
-	hwc->config |=3D config;
-
-	return ret;
-}
-
-static void bfin_pmu_enable(struct pmu *pmu)
-{
-	struct cpu_hw_events *cpuc =3D this_cpu_ptr(&cpu_hw_events);
-	struct perf_event *event;
-	struct hw_perf_event *hwc;
-	int i;
-
-	for (i =3D 0; i < MAX_HWEVENTS; ++i) {
-		event =3D cpuc->events[i];
-		if (!event)
-			continue;
-		hwc =3D &event->hw;
-		bfin_pfmon_enable(hwc, hwc->idx);
-	}
-
-	bfin_pfmon_enable_all();
-}
-
-static void bfin_pmu_disable(struct pmu *pmu)
-{
-	bfin_pfmon_disable_all();
-}
-
-static struct pmu pmu =3D {
-	.pmu_enable  =3D bfin_pmu_enable,
-	.pmu_disable =3D bfin_pmu_disable,
-	.event_init  =3D bfin_pmu_event_init,
-	.add         =3D bfin_pmu_add,
-	.del         =3D bfin_pmu_del,
-	.start       =3D bfin_pmu_start,
-	.stop        =3D bfin_pmu_stop,
-	.read        =3D bfin_pmu_read,
-};
-
-static int bfin_pmu_prepare_cpu(unsigned int cpu)
-{
-	struct cpu_hw_events *cpuhw =3D &per_cpu(cpu_hw_events, cpu);
-
-	bfin_write_PFCTL(0);
-	memset(cpuhw, 0, sizeof(struct cpu_hw_events));
-	return 0;
-}
-
-static int __init bfin_pmu_init(void)
-{
-	int ret;
-
-	/*
-	 * All of the on-chip counters are "limited", in that they have
-	 * no interrupts, and are therefore unable to do sampling without
-	 * further work and timer assistance.
-	 */
-	pmu.capabilities |=3D PERF_PMU_CAP_NO_INTERRUPT;
