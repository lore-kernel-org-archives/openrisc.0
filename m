-	dest_in_l1 =3D isram_check_addr(dest, n);
-	src_in_l1 =3D isram_check_addr(src, n);
-
-	need_data =3D true;
-	put_data =3D true;
-	for (count =3D 0; count < n; count++) {
-		if (src_in_l1) {
-			if (need_data) {
-				data_in =3D isram_read(src + count);
-				need_data =3D false;
-			}
-
-			if (ADDR2LAST(src + count))
