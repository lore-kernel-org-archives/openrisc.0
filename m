-/* Allocate memory and keep in L1 SRAM List (lsl) so that the resources are
- * tracked.  These are designed for userspace so that when a process exits,
- * we can safely reap their resources.
- */
-void *sram_alloc_with_lsl(size_t size, unsigned long flags)
-{
-	void *addr =3D NULL;
-	struct sram_list_struct *lsl =3D NULL;
-	struct mm_struct *mm =3D current->mm;
-
-	lsl =3D kzalloc(sizeof(struct sram_list_struct), GFP_KERNEL);
-	if (!lsl)
-		return NULL;
-
-	if (flags & L1_INST_SRAM)
-		addr =3D l1_inst_sram_alloc(size);
-
-	if (addr =3D=3D NULL && (flags & L1_DATA_A_SRAM))
-		addr =3D l1_data_A_sram_alloc(size);
-
-	if (addr =3D=3D NULL && (flags & L1_DATA_B_SRAM))
-		addr =3D l1_data_B_sram_alloc(size);
-
-	if (addr =3D=3D NULL && (flags & L2_SRAM))
-		addr =3D l2_sram_alloc(size);
-
-	if (addr =3D=3D NULL) {
-		kfree(lsl);
-		return NULL;
-	}
-	lsl->addr =3D addr;
-	lsl->length =3D size;
-	lsl->next =3D mm->context.sram_list;
-	mm->context.sram_list =3D lsl;
-	return addr;
-}
