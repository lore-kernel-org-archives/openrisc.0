-
-      /* TLB Way 1 Translate registers */
-      if ((OR1K_SPG_DMMU_DTLBW1TR <= index)
-	  && (index <= OR1K_SPG_DMMU_DTLBW1TR_END))
-	{
-	  sprintf (name, "%cTLBW1TR%d", di, index - OR1K_SPG_DMMU_DTLBW1TR);
