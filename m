-/*
- * Write contents of register REGNO in task TASK.
- */
-static inline int
-put_reg(struct task_struct *task, unsigned long regno, unsigned long data)
-{
-	struct pt_regs *regs =3D task_pt_regs(task);
-
-	if (regno & 3 || regno > PT_LAST_PSEUDO)
-		return -EIO;
-
-	switch (regno) {
-	case PT_PC:
-		/*********************************************************************/
-		/* At this point the kernel is most likely in exception.             */
-		/* The RETX register will be used to populate the pc of the process. */
-		/*********************************************************************/
-		regs->retx =3D data;
-		regs->pc =3D data;
-		break;
-	case PT_RETX:
-		break;		/* regs->retx =3D data; break; */
-	case PT_USP:
-		regs->usp =3D data;
-		task->thread.usp =3D data;
-		break;
-	case PT_SYSCFG:	/* don't let userspace screw with this */
-		if ((data & ~1) !=3D 0x6)
-			pr_warning("ptrace: ignore syscfg write of %#lx\n", data);
-		break;		/* regs->syscfg =3D data; break; */
-	default:
-		if (regno < sizeof(*regs)) {
-			void *reg_offset =3D regs;
-			*(long *)(reg_offset + regno) =3D data;
-		}
-		/* Ignore writes to pseudo registers */
-	}
