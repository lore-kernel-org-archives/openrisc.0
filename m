-
-#include <linux/linkage.h>
-#include <linux/init.h>
-#include <asm/blackfin.h>
-#include <asm/asm-offsets.h>
-#include <asm/trace.h>
-
-/*
- * This code must come first as CoreB is hardcoded (in hardware)
- * to start at the beginning of its L1 instruction memory.
- */
-.section .l1.text.head
-
-/* Lay the initial stack into the L1 scratch area of Core B */
-#define INITIAL_STACK	(COREB_L1_SCRATCH_START + L1_SCRATCH_LENGTH - 12)
-
-ENTRY(_coreb_trampoline_start)
-	/* Enable Cycle Counter and Nesting Of Interrupts */
-#ifdef CONFIG_BFIN_SCRATCH_REG_CYCLES
-	R0 =3D SYSCFG_SNEN;
-#else
-	R0 =3D SYSCFG_SNEN | SYSCFG_CCEN;
-#endif
-	SYSCFG =3D R0;
-
-	/* Optimization register tricks: keep a base value in the
-	 * reserved P registers so we use the load/store with an
-	 * offset syntax.  R0 =3D [P5 + <constant>];
-	 *   P5 - core MMR base
-	 *   R6 - 0
-	 */
-	r6 =3D 0;
-	p5.l =3D 0;
-	p5.h =3D hi(COREMMR_BASE);
-
-	/* Zero out registers required by Blackfin ABI */
-
-	/* Disable circular buffers */
-	L0 =3D r6;
-	L1 =3D r6;
-	L2 =3D r6;
-	L3 =3D r6;
-
-	/* Disable hardware loops in case we were started by 'go' */
-	LC0 =3D r6;
-	LC1 =3D r6;
-
-	/*
-	 * Clear ITEST_COMMAND and DTEST_COMMAND registers,
-	 * Leaving these as non-zero can confuse the emulator
-	 */
-	[p5 + (DTEST_COMMAND - COREMMR_BASE)] =3D r6;
-	[p5 + (ITEST_COMMAND - COREMMR_BASE)] =3D r6;
-	CSYNC;
-
-	trace_buffer_init(p0,r0);
-
-	/* Turn off the icache */
-	r1 =3D [p5 + (IMEM_CONTROL - COREMMR_BASE)];
-	BITCLR (r1, ENICPLB_P);
-	[p5 + (IMEM_CONTROL - COREMMR_BASE)] =3D r1;
-	SSYNC;
-
-	/* Turn off the dcache */
-	r1 =3D [p5 + (DMEM_CONTROL - COREMMR_BASE)];
-	BITCLR (r1, ENDCPLB_P);
-	[p5 + (DMEM_CONTROL - COREMMR_BASE)] =3D r1;
-	SSYNC;
-
-	/* in case of double faults, save a few things */
-	p1.l =3D _initial_pda_coreb;
-	p1.h =3D _initial_pda_coreb;
-	r4 =3D RETX;
-#ifdef CONFIG_DEBUG_DOUBLEFAULT
-	/* Only save these if we are storing them,
-	 * This happens here, since L1 gets clobbered
-	 * below
-	 */
-	GET_PDA(p0, r0);
-	r0 =3D [p0 + PDA_DF_RETX];
-	r1 =3D [p0 + PDA_DF_DCPLB];
-	r2 =3D [p0 + PDA_DF_ICPLB];
-	r3 =3D [p0 + PDA_DF_SEQSTAT];
-	[p1 + PDA_INIT_DF_RETX] =3D r0;
-	[p1 + PDA_INIT_DF_DCPLB] =3D r1;
-	[p1 + PDA_INIT_DF_ICPLB] =3D r2;
-	[p1 + PDA_INIT_DF_SEQSTAT] =3D r3;
-#endif
-	[p1 + PDA_INIT_RETX] =3D r4;
-
-	/* Initialize stack pointer */
-	sp.l =3D lo(INITIAL_STACK);
-	sp.h =3D hi(INITIAL_STACK);
-	fp =3D sp;
-	usp =3D sp;
-
-	/* This section keeps the processor in supervisor mode
-	 * during core B startup.  Branches to the idle task.
-	 */
-
-	/* EVT15 =3D _real_start */
-
-	p1.l =3D _coreb_start;
-	p1.h =3D _coreb_start;
-	[p5 + (EVT15 - COREMMR_BASE)] =3D p1;
-	csync;
-
-	r0 =3D EVT_IVG15 (z);
-	sti r0;
-
-	raise 15;
-	p0.l =3D .LWAIT_HERE;
-	p0.h =3D .LWAIT_HERE;
-	reti =3D p0;
-#if defined(ANOMALY_05000281)
-	nop; nop; nop;
-#endif
-	rti;
-
-.LWAIT_HERE:
-	jump .LWAIT_HERE;
-ENDPROC(_coreb_trampoline_start)
-
-#ifdef CONFIG_HOTPLUG_CPU
-.section ".text"
-ENTRY(_coreb_die)
-	sp.l =3D lo(INITIAL_STACK);
-	sp.h =3D hi(INITIAL_STACK);
-	fp =3D sp;
-	usp =3D sp;
-
-	CLI R2;
-	SSYNC;
-	IDLE;
-	STI R2;
-
-	R0 =3D IWR_DISABLE_ALL;
-	P0.H =3D hi(SYSMMR_BASE);
-	P0.L =3D lo(SYSMMR_BASE);
-	[P0 + (SICB_IWR0 - SYSMMR_BASE)] =3D R0;
-	[P0 + (SICB_IWR1 - SYSMMR_BASE)] =3D R0;
-	SSYNC;
-
-	p0.h =3D hi(COREB_L1_CODE_START);
-	p0.l =3D lo(COREB_L1_CODE_START);
-	jump (p0);
-ENDPROC(_coreb_die)
-#endif
-
-__INIT
-ENTRY(_coreb_start)
-	[--sp] =3D reti;
-
-	p0.l =3D lo(WDOGB_CTL);
-	p0.h =3D hi(WDOGB_CTL);
-	r0 =3D 0xAD6(z);
-	w[p0] =3D r0;	/* Clear the watchdog. */
-	ssync;
-
-	/*
-	 * switch to IDLE stack.
-	 */
-	p0.l =3D _secondary_stack;
-	p0.h =3D _secondary_stack;
-	sp =3D [p0];
-	usp =3D sp;
-	fp =3D sp;
-#ifdef CONFIG_HOTPLUG_CPU
-	p0.l =3D _hotplug_coreb;
-	p0.h =3D _hotplug_coreb;
-	r0 =3D [p0];
-	cc =3D BITTST(r0, 0);
-	if cc jump 3f;
-#endif
-	sp +=3D -12;
-	call _init_pda
-	sp +=3D 12;
-#ifdef CONFIG_HOTPLUG_CPU
-3:
-#endif
-	call _secondary_start_kernel;
-.L_exit:
-	jump.s	.L_exit;
-ENDPROC(_coreb_start)
