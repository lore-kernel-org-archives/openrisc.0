-/*
- * Sanitize the boot memmap, removing overlaps.
- */
-static int __init sanitize_memmap(struct bfin_memmap_entry *map, int *pnr_=
map)
-{
-	struct change_member *change_tmp;
-	unsigned long current_type, last_type;
-	unsigned long long last_addr;
-	int chgidx, still_changing;
-	int overlap_entries;
-	int new_entry;
-	int old_nr, new_nr, chg_nr;
-	int i;
-
-	/*
-		Visually we're performing the following (1,2,3,4 =3D memory types)
-
-		Sample memory map (w/overlaps):
-		   ____22__________________
-		   ______________________4_
-		   ____1111________________
-		   _44_____________________
-		   11111111________________
-		   ____________________33__
-		   ___________44___________
-		   __________33333_________
-		   ______________22________
-		   ___________________2222_
-		   _________111111111______
-		   _____________________11_
-		   _________________4______
-
-		Sanitized equivalent (no overlap):
-		   1_______________________
-		   _44_____________________
-		   ___1____________________
-		   ____22__________________
-		   ______11________________
-		   _________1______________
-		   __________3_____________
-		   ___________44___________
-		   _____________33_________
-		   _______________2________
-		   ________________1_______
-		   _________________4______
-		   ___________________2____
-		   ____________________33__
-		   ______________________4_
-	*/
-	/* if there's only one memory region, don't bother */
-	if (*pnr_map < 2)
-		return -1;
-
-	old_nr =3D *pnr_map;
-
-	/* bail out if we find any unreasonable addresses in memmap */
-	for (i =3D 0; i < old_nr; i++)
-		if (map[i].addr + map[i].size < map[i].addr)
-			return -1;
-
-	/* create pointers for initial change-point information (for sorting) */
-	for (i =3D 0; i < 2*old_nr; i++)
-		change_point[i] =3D &change_point_list[i];
-
-	/* record all known change-points (starting and ending addresses),
-	   omitting those that are for empty memory regions */
-	chgidx =3D 0;
-	for (i =3D 0; i < old_nr; i++) {
-		if (map[i].size !=3D 0) {
-			change_point[chgidx]->addr =3D map[i].addr;
-			change_point[chgidx++]->pentry =3D &map[i];
-			change_point[chgidx]->addr =3D map[i].addr + map[i].size;
-			change_point[chgidx++]->pentry =3D &map[i];
-		}
-	}
-	chg_nr =3D chgidx;	/* true number of change-points */
-
-	/* sort change-point list by memory addresses (low -> high) */
-	still_changing =3D 1;
-	while (still_changing) {
-		still_changing =3D 0;
-		for (i =3D 1; i < chg_nr; i++) {
-			/* if <current_addr> > <last_addr>, swap */
-			/* or, if current=3D<start_addr> & last=3D<end_addr>, swap */
-			if ((change_point[i]->addr < change_point[i-1]->addr) ||
-				((change_point[i]->addr =3D=3D change_point[i-1]->addr) &&
-				 (change_point[i]->addr =3D=3D change_point[i]->pentry->addr) &&
-				 (change_point[i-1]->addr !=3D change_point[i-1]->pentry->addr))
-			   ) {
-				change_tmp =3D change_point[i];
-				change_point[i] =3D change_point[i-1];
-				change_point[i-1] =3D change_tmp;
-				still_changing =3D 1;
-			}
-		}
-	}
-
-	/* create a new memmap, removing overlaps */
-	overlap_entries =3D 0;	/* number of entries in the overlap table */
-	new_entry =3D 0;		/* index for creating new memmap entries */
-	last_type =3D 0;		/* start with undefined memory type */
-	last_addr =3D 0;		/* start with 0 as last starting address */
-	/* loop through change-points, determining affect on the new memmap */
-	for (chgidx =3D 0; chgidx < chg_nr; chgidx++) {
-		/* keep track of all overlapping memmap entries */
-		if (change_point[chgidx]->addr =3D=3D change_point[chgidx]->pentry->addr=
) {
-			/* add map entry to overlap list (> 1 entry implies an overlap) */
-			overlap_list[overlap_entries++] =3D change_point[chgidx]->pentry;
-		} else {
-			/* remove entry from list (order independent, so swap with last) */
-			for (i =3D 0; i < overlap_entries; i++) {
-				if (overlap_list[i] =3D=3D change_point[chgidx]->pentry)
-					overlap_list[i] =3D overlap_list[overlap_entries-1];
-			}
-			overlap_entries--;
-		}
-		/* if there are overlapping entries, decide which "type" to use */
-		/* (larger value takes precedence -- 1=3Dusable, 2,3,4,4+=3Dunusable) */
-		current_type =3D 0;
-		for (i =3D 0; i < overlap_entries; i++)
-			if (overlap_list[i]->type > current_type)
-				current_type =3D overlap_list[i]->type;
-		/* continue building up new memmap based on this information */
-		if (current_type !=3D last_type) {
-			if (last_type !=3D 0) {
-				new_map[new_entry].size =3D
-					change_point[chgidx]->addr - last_addr;
-				/* move forward only if the new size was non-zero */
-				if (new_map[new_entry].size !=3D 0)
-					if (++new_entry >=3D BFIN_MEMMAP_MAX)
-						break;	/* no more space left for new entries */
-			}
-			if (current_type !=3D 0) {
-				new_map[new_entry].addr =3D change_point[chgidx]->addr;
-				new_map[new_entry].type =3D current_type;
-				last_addr =3D change_point[chgidx]->addr;
-			}
-			last_type =3D current_type;
-		}
-	}
-	new_nr =3D new_entry;	/* retain count for new entries */
-
-	/* copy new mapping into original location */
-	memcpy(map, new_map, new_nr*sizeof(struct bfin_memmap_entry));
-	*pnr_map =3D new_nr;
-
-	return 0;
-}
