-
-			byte =3D (unsigned char)((data_in >> ADDR2OFFSET(src + count)) & 0xff);
-
-		} else {
-			/* src is in L2 or L3 - so just dereference*/
-			byte =3D src_byte[count];
-		}
-
-		if (dest_in_l1) {
-			if (put_data) {
-				data_out =3D isram_read(dest + count);
-				put_data =3D false;
-			}
-
-			data_out &=3D ~((uint64_t)0xff << ADDR2OFFSET(dest + count));
-			data_out |=3D ((uint64_t)byte << ADDR2OFFSET(dest + count));
